rules_version = '2';

// ===============================================================
// Assumed Data Model — Klox (klox.dev)
// ===============================================================
//
// Strict per-user tenant isolation: all personal application documents
// live under `users/{userId}/...`, where an authenticated user may only
// read and write documents when `request.auth.uid == userId`.
// The only shared top-level collection is `usernames/{username}`, a
// minimal non-PII handle reservation index (`allow get` for authenticated
// users, `allow list: if false` anti-enumeration) enforcing global uniqueness.
// Cross-tenant access and unauthenticated access are denied everywhere.
//
// Collection: users/{userId}
// Document ID: {userId} (Firebase Auth UID)
// Fields:
//   - displayName: string | null (optional, <= 120 chars)
//   - email: string | null (optional, <= 254 chars, PII — owner-only read)
//   - username: string | null (optional, 3..24 chars lowercase [a-z0-9_-], unique handle)
//   - photoURL: string | null (optional, <= 2048 chars, Google/OAuth URL)
//   - customAvatarUrl: string | null (optional, <= 120000 chars, raster WebP/JPEG/PNG data URI)
//   - activeTimer: map | null (optional, singleton live stopwatch state)
//   - preferences: map (optional, regional settings: locale, timeZone, weekStartsOn, dateFormat, hourCycle; optional keyboardShortcuts map <= 20 entries; optional taskTrackingPolicy map)
//   - onboarding: map (optional, wizardStatus, version, profile, checklist, timestamps)
//   - adoConnection: map | null (optional, legacy single non-secret Azure DevOps connection summary; optional completedWorkFieldRef)
//   - adoConnections: list<map> | null (optional, max 25 project-bound Azure DevOps connection summaries; optional completedWorkFieldRef)
//   - updatedAt: string (optional, UTC ISO timestamp <= 64 chars)
//
// Collection: usernames/{username}
// Document ID: {username} (normalized lowercase handle, 3..24 chars [a-z0-9_-])
// Fields:
//   - uid: string (required, immutable, must equal request.auth.uid on create)
//   - createdAt: string (required, immutable, UTC ISO timestamp 1..64 chars)
//
// Collection: users/{userId}/projects/{projectId}
// Document ID: {projectId}
// Fields:
//   - id: string (required, immutable, must equal projectId, 1..128 chars)
//   - userId: string (required, immutable, must equal userId)
//   - name: string (required, 1..120 chars)
//   - color: string (required, hex color #RRGGBB)
//   - isBillableDefault: bool (required)
//   - createdAt: string (required, immutable, UTC ISO string 10..64 chars)
//   - systemKey: string | null (optional, allowed value: 'unassigned')
//   - adoConfig: map | null (optional, per-project Azure DevOps override: enabled, orgUrl?, project?, defaultWorkItemType?)
//
// Collection: users/{userId}/tags/{tagId}
// Document ID: {tagId}
// Fields:
//   - id: string (required, immutable, must equal tagId, 1..128 chars)
//   - userId: string (required, immutable, must equal userId)
//   - projectId: string (required, immutable, 1..128 chars)
//   - name: string (required, 1..80 chars)
//   - createdAt: string (required, immutable, UTC ISO string 10..64 chars)
//
// Collection: users/{userId}/tasks/{taskId}
// Document ID: {taskId}
// Fields:
//   - id: string (required, immutable, must equal taskId, 1..128 chars)
//   - userId: string (required, immutable, must equal userId)
//   - projectId: string (required, 1..128 chars)
//   - parentTaskId: string | null (optional, <= 128 chars, must not equal taskId)
//   - depth: int | null (optional, in [0, 1, 2])
//   - sortOrder: number | null (optional, sparse sibling priority rank -1000000000..1000000000)
//   - name: string (required, 1..200 chars)
//   - description: string | null (optional, <= 4000 chars, Markdown)
//   - tagIds: list<string> | null (optional, max 25 project-scoped Tag ID strings 1..128 chars)
//   - dueDate: string | null (optional, 10 chars YYYY-MM-DD deadline date)
//   - completedWorkHours: number (required, >= 0 and <= 100000)
//   - status: string (required, in ['todo', 'in_progress', 'done'])
//   - createdAt: string (required, immutable, UTC ISO string 10..64 chars)
//   - targetHours: number | null (optional, >= 0 and <= 100000)
//   - externalProvider: string | null (optional, 'azure_devops' or null)
//   - externalWorkItemId: string | null (optional, <= 128 chars)
//   - externalWorkItemTitle: string | null (optional, <= 300 chars)
//   - externalWorkItemType: string | null (optional, <= 80 chars)
//   - externalWorkItemUrl: string | null (optional, <= 512 chars, https:// URL)
//   - externalOrgUrl: string | null (optional, <= 200 chars)
//   - externalProject: string | null (optional, <= 128 chars)
//   - externalSyncedAt: string | null (optional, UTC ISO string <= 64 chars)
//   - externalSupportsCompletedWork: bool | null (optional, whether external ADO work item type supports CompletedWork)
//
// Collection: users/{userId}/timeLogs/{logId}
// Document ID: {logId}
// Fields:
//   - id: string (required, immutable, must equal logId, 1..128 chars)
//   - userId: string (required, immutable, must equal userId)
//   - description: string (required, 0..500 chars)
//   - normalizedDescription: string (required, 0..500 chars)
//   - projectId: string (required, 1..128 chars)
//   - projectNameSnapshot: string (required, 1..120 chars)
//   - projectColorSnapshot: string (required, 1..32 chars)
//   - taskId: string | null (optional, <= 128 chars)
//   - taskNameSnapshot: string | null (optional, <= 200 chars)
//   - tagIds: list<string> (required, max 25 items)
//   - tagNamesSnapshot: list<string> | null (optional, legacy, max 25 items)
//   - isBillable: bool (required)
//   - startTime: string (required, UTC ISO string 10..64 chars)
//   - endTime: string (required, UTC ISO string 10..64 chars)
//   - durationSeconds: number (required, >= 0 and <= 31536000)
//   - timeZone: string (required, IANA timezone 1..100 chars)
//   - dateKey: string (required, 10 chars YYYY-MM-DD)
//   - adoSync: map | null (optional, Azure DevOps sync ledger: workItemId, orgUrl, project, syncedSeconds, syncedAt)
//
// Collection: users/{userId}/secrets/{secretId}
// Document ID: {secretId} (only 'azureDevOps' is allowed)
// Access: Owner-only ciphertext envelope access via verified Firebase ID token
//         (`secretId == 'azureDevOps'`, `allow list: if false`). Payloads are encrypted/decrypted
//         strictly server-side (AES-256-GCM via `NUXT_ADO_ENCRYPTION_KEY`); plaintext tokens are never stored.
// Fields:
//   - v: int (required, == 1)
//   - authType: string (required, in ['pat', 'entra_oauth'])
//   - salt: string (required, base64 1..128 chars)
//   - iv: string (required, base64 1..64 chars)
//   - tag: string (required, base64 1..64 chars)
//   - ciphertext: string (required, base64 1..16384 chars)
//   - updatedAt: string (required, UTC ISO string 1..64 chars)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function isNonEmptyString(val, maxLen) {
      return val is string && val.size() >= 1 && val.size() <= maxLen;
    }

    function isBoundedString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    function isOptionalBoundedString(data, field, maxLen) {
      return !(field in data) || data[field] == null || isBoundedString(data[field], maxLen);
    }

    function isValidHexColor(color) {
      return color is string && color.matches('^#[0-9A-Fa-f]{6}$');
    }

    function isValidDateKey(dateKey) {
      return dateKey is string &&
        dateKey.size() == 10 &&
        dateKey.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function isValidList(listVal, maxSize) {
      return listVal is list && listVal.size() <= maxSize;
    }

    function isValidStringIdList25(listVal, maxItemLen) {
      return isValidList(listVal, 25) &&
        (listVal.size() == 0 || isNonEmptyString(listVal[0], maxItemLen)) &&
        (listVal.size() <= 1 || isNonEmptyString(listVal[1], maxItemLen)) &&
        (listVal.size() <= 2 || isNonEmptyString(listVal[2], maxItemLen)) &&
        (listVal.size() <= 3 || isNonEmptyString(listVal[3], maxItemLen)) &&
        (listVal.size() <= 4 || isNonEmptyString(listVal[4], maxItemLen)) &&
        (listVal.size() <= 5 || isNonEmptyString(listVal[5], maxItemLen)) &&
        (listVal.size() <= 6 || isNonEmptyString(listVal[6], maxItemLen)) &&
        (listVal.size() <= 7 || isNonEmptyString(listVal[7], maxItemLen)) &&
        (listVal.size() <= 8 || isNonEmptyString(listVal[8], maxItemLen)) &&
        (listVal.size() <= 9 || isNonEmptyString(listVal[9], maxItemLen)) &&
        (listVal.size() <= 10 || isNonEmptyString(listVal[10], maxItemLen)) &&
        (listVal.size() <= 11 || isNonEmptyString(listVal[11], maxItemLen)) &&
        (listVal.size() <= 12 || isNonEmptyString(listVal[12], maxItemLen)) &&
        (listVal.size() <= 13 || isNonEmptyString(listVal[13], maxItemLen)) &&
        (listVal.size() <= 14 || isNonEmptyString(listVal[14], maxItemLen)) &&
        (listVal.size() <= 15 || isNonEmptyString(listVal[15], maxItemLen)) &&
        (listVal.size() <= 16 || isNonEmptyString(listVal[16], maxItemLen)) &&
        (listVal.size() <= 17 || isNonEmptyString(listVal[17], maxItemLen)) &&
        (listVal.size() <= 18 || isNonEmptyString(listVal[18], maxItemLen)) &&
        (listVal.size() <= 19 || isNonEmptyString(listVal[19], maxItemLen)) &&
        (listVal.size() <= 20 || isNonEmptyString(listVal[20], maxItemLen)) &&
        (listVal.size() <= 21 || isNonEmptyString(listVal[21], maxItemLen)) &&
        (listVal.size() <= 22 || isNonEmptyString(listVal[22], maxItemLen)) &&
        (listVal.size() <= 23 || isNonEmptyString(listVal[23], maxItemLen)) &&
        (listVal.size() <= 24 || isNonEmptyString(listVal[24], maxItemLen));
    }

    function isValidUsernameHandle(handle) {
      return handle is string &&
        handle.size() >= 3 &&
        handle.size() <= 24 &&
        handle.matches('^[a-z0-9][a-z0-9_-]{1,22}[a-z0-9]$') &&
        !handle.matches('.*[-_]{2}.*');
    }

    // ===============================================================
    // Domain Validators (Invoked on BOTH create and update)
    // ===============================================================

    function isValidTaskTrackingPolicy(policy) {
      return policy is map &&
        policy.keys().hasAll(['allowNonCompletedWorkTracking', 'allowParentTaskTracking']) &&
        policy.keys().hasOnly(['allowNonCompletedWorkTracking', 'allowParentTaskTracking']) &&
        policy.allowNonCompletedWorkTracking is bool &&
        policy.allowParentTaskTracking is bool;
    }

    function isValidPreferences(prefs) {
      return prefs is map &&
        prefs.keys().hasAll(['locale', 'timeZone', 'weekStartsOn', 'dateFormat', 'hourCycle']) &&
        prefs.keys().hasOnly(['locale', 'timeZone', 'weekStartsOn', 'dateFormat', 'hourCycle', 'keyboardShortcuts', 'taskTrackingPolicy']) &&
        prefs.locale in ['en', 'pt-br'] &&
        isNonEmptyString(prefs.timeZone, 100) &&
        prefs.weekStartsOn in [0, 1, 6] &&
        prefs.dateFormat in ['locale', 'YYYY-MM-DD', 'DD/MM/YYYY', 'MM/DD/YYYY'] &&
        prefs.hourCycle in ['h12', 'h23'] &&
        (!('keyboardShortcuts' in prefs) || prefs.keyboardShortcuts == null || (prefs.keyboardShortcuts is map && prefs.keyboardShortcuts.size() <= 20)) &&
        (!('taskTrackingPolicy' in prefs) || prefs.taskTrackingPolicy == null || isValidTaskTrackingPolicy(prefs.taskTrackingPolicy));
    }

    function isValidOnboarding(onboarding) {
      return onboarding is map &&
        onboarding.keys().hasAll(['version', 'wizardStatus']) &&
        onboarding.keys().hasOnly([
          'version',
          'wizardStatus',
          'profile',
          'tutorialCompletedAt',
          'checklist',
          'checklistDismissedAt'
        ]) &&
        onboarding.version is int &&
        onboarding.version >= 1 &&
        onboarding.version <= 100 &&
        onboarding.wizardStatus in ['pending', 'completed', 'skipped'] &&
        (!('profile' in onboarding) || onboarding.profile == null || onboarding.profile in ['work', 'personal', 'both']) &&
        isOptionalBoundedString(onboarding, 'tutorialCompletedAt', 64) &&
        isOptionalBoundedString(onboarding, 'checklistDismissedAt', 64) &&
        (!('checklist' in onboarding) || (onboarding.checklist is map && onboarding.checklist.size() <= 20));
    }

    function isValidActiveTimer(timer) {
      return timer == null || (
        timer is map &&
        timer.keys().hasAll(['description', 'projectId', 'tagIds', 'isBillable', 'startTimeUTC']) &&
        timer.keys().hasOnly([
          'description',
          'projectId',
          'taskId',
          'taskNameSnapshot',
          'tagIds',
          'isBillable',
          'startTimeUTC'
        ]) &&
        isBoundedString(timer.description, 500) &&
        isNonEmptyString(timer.projectId, 128) &&
        isOptionalBoundedString(timer, 'taskId', 128) &&
        isOptionalBoundedString(timer, 'taskNameSnapshot', 200) &&
        isValidList(timer.tagIds, 25) &&
        timer.isBillable is bool &&
        isNonEmptyString(timer.startTimeUTC, 64)
      );
    }

    function isValidAdoConnection(conn) {
      return conn is map &&
        conn.keys().hasAll([
          'connected',
          'authType',
          'orgUrl',
          'organization',
          'defaultProject',
          'defaultWorkItemType',
          'tokenHint',
          'connectedAt',
          'lastVerifiedAt'
        ]) &&
        conn.keys().hasOnly([
          'connected',
          'authType',
          'orgUrl',
          'organization',
          'defaultProject',
          'defaultWorkItemType',
          'completedWorkFieldRef',
          'tokenHint',
          'connectedAt',
          'lastVerifiedAt'
        ]) &&
        conn.connected is bool &&
        conn.authType in ['pat', 'entra_oauth'] &&
        conn.orgUrl is string &&
        conn.orgUrl.size() <= 200 &&
        conn.orgUrl.matches('^https://dev\\.azure\\.com/[A-Za-z0-9][A-Za-z0-9-]{0,62}$') &&
        isNonEmptyString(conn.organization, 80) &&
        isNonEmptyString(conn.defaultProject, 128) &&
        isNonEmptyString(conn.defaultWorkItemType, 80) &&
        (!('completedWorkFieldRef' in conn) || conn.completedWorkFieldRef == null || (conn.completedWorkFieldRef is string && conn.completedWorkFieldRef.size() >= 3 && conn.completedWorkFieldRef.size() <= 128 && conn.completedWorkFieldRef.matches('^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)+$'))) &&
        isNonEmptyString(conn.tokenHint, 32) &&
        isNonEmptyString(conn.connectedAt, 64) &&
        isNonEmptyString(conn.lastVerifiedAt, 64);
    }

    function isValidAdoConnectionItem(conn) {
      return conn is map &&
        conn.keys().hasAll([
          'id',
          'kloxProjectId',
          'connected',
          'authType',
          'orgUrl',
          'organization',
          'defaultProject',
          'defaultWorkItemType',
          'tokenHint',
          'connectedAt',
          'lastVerifiedAt'
        ]) &&
        conn.keys().hasOnly([
          'id',
          'kloxProjectId',
          'connected',
          'authType',
          'orgUrl',
          'organization',
          'defaultProject',
          'defaultWorkItemType',
          'completedWorkFieldRef',
          'tokenHint',
          'connectedAt',
          'lastVerifiedAt'
        ]) &&
        isNonEmptyString(conn.id, 128) &&
        isNonEmptyString(conn.kloxProjectId, 128) &&
        conn.kloxProjectId != 'system_unassigned' &&
        conn.connected is bool &&
        conn.authType in ['pat', 'entra_oauth'] &&
        conn.orgUrl is string &&
        conn.orgUrl.size() <= 200 &&
        conn.orgUrl.matches('^https://dev\\.azure\\.com/[A-Za-z0-9][A-Za-z0-9-]{0,62}$') &&
        isNonEmptyString(conn.organization, 80) &&
        isNonEmptyString(conn.defaultProject, 128) &&
        isNonEmptyString(conn.defaultWorkItemType, 80) &&
        (!('completedWorkFieldRef' in conn) || conn.completedWorkFieldRef == null || (conn.completedWorkFieldRef is string && conn.completedWorkFieldRef.size() >= 3 && conn.completedWorkFieldRef.size() <= 128 && conn.completedWorkFieldRef.matches('^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)+$'))) &&
        isNonEmptyString(conn.tokenHint, 32) &&
        isNonEmptyString(conn.connectedAt, 64) &&
        isNonEmptyString(conn.lastVerifiedAt, 64);
    }

    function isValidUserProfile(data) {
      return hasOnlyAllowedFields([
          'displayName',
          'email',
          'username',
          'photoURL',
          'customAvatarUrl',
          'activeTimer',
          'preferences',
          'onboarding',
          'adoConnection',
          'adoConnections',
          'updatedAt'
        ]) &&
        isOptionalBoundedString(data, 'displayName', 120) &&
        isOptionalBoundedString(data, 'email', 254) &&
        (!('username' in data) || data.username == null || isValidUsernameHandle(data.username)) &&
        (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 2048 && (data.photoURL.size() == 0 || data.photoURL.matches('^https://.+')))) &&
        (!('customAvatarUrl' in data) || data.customAvatarUrl == null || (data.customAvatarUrl is string && data.customAvatarUrl.size() <= 120000 && data.customAvatarUrl.matches('^data:image/(webp|jpeg|png);base64,[A-Za-z0-9+/]+=*$'))) &&
        isOptionalBoundedString(data, 'updatedAt', 64) &&
        (!('activeTimer' in data) || isValidActiveTimer(data.activeTimer)) &&
        (!('preferences' in data) || isValidPreferences(data.preferences)) &&
        (!('onboarding' in data) || isValidOnboarding(data.onboarding)) &&
        (!('adoConnection' in data) || data.adoConnection == null || isValidAdoConnection(data.adoConnection)) &&
        (!('adoConnections' in data) || data.adoConnections == null || (
          data.adoConnections is list &&
          data.adoConnections.size() <= 25 &&
          (data.adoConnections.size() == 0 || isValidAdoConnectionItem(data.adoConnections[0])) &&
          (data.adoConnections.size() <= 1 || isValidAdoConnectionItem(data.adoConnections[1])) &&
          (data.adoConnections.size() <= 2 || isValidAdoConnectionItem(data.adoConnections[2])) &&
          (data.adoConnections.size() <= 3 || isValidAdoConnectionItem(data.adoConnections[3])) &&
          (data.adoConnections.size() <= 4 || isValidAdoConnectionItem(data.adoConnections[4]))
        ));
    }

    function hasClaimedUsernameAfter(userId, handle) {
      let claim = getAfter(/databases/$(database)/documents/usernames/$(handle));
      return claim != null &&
        'uid' in claim.data &&
        claim.data.uid == userId;
    }

    // Enforce atomic usernames/{username} claim on create or username change.
    // Short-circuits before getAfter() when username is absent, null, or
    // unchanged on update so activeTimer/preferences/onboarding writes cost
    // zero extra reads.
    function isValidUserProfileUsernameOwnership(userId) {
      return !('username' in request.resource.data) ||
        request.resource.data.username == null ||
        (
          resource != null &&
          'username' in resource.data &&
          resource.data.username == request.resource.data.username
        ) ||
        (
          isValidUsernameHandle(request.resource.data.username) &&
          hasClaimedUsernameAfter(userId, request.resource.data.username)
        );
    }

    function isValidProjectAdoConfig(cfg) {
      return cfg is map &&
        cfg.keys().hasAll(['enabled']) &&
        cfg.keys().hasOnly(['enabled', 'orgUrl', 'project', 'defaultWorkItemType']) &&
        cfg.enabled is bool &&
        isOptionalBoundedString(cfg, 'orgUrl', 200) &&
        isOptionalBoundedString(cfg, 'project', 128) &&
        isOptionalBoundedString(cfg, 'defaultWorkItemType', 80);
    }

    function isValidProject(data, userId, projectId) {
      return hasRequiredFields(['id', 'userId', 'name', 'color', 'isBillableDefault', 'createdAt']) &&
        hasOnlyAllowedFields(['id', 'userId', 'name', 'color', 'isBillableDefault', 'createdAt', 'systemKey', 'adoConfig']) &&
        data.id is string && data.id == projectId && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.userId is string && data.userId == userId &&
        isNonEmptyString(data.name, 120) &&
        isValidHexColor(data.color) &&
        data.isBillableDefault is bool &&
        isNonEmptyString(data.createdAt, 64) &&
        (!('systemKey' in data) || data.systemKey == null || data.systemKey == 'unassigned') &&
        (!('adoConfig' in data) || data.adoConfig == null || isValidProjectAdoConfig(data.adoConfig));
    }

    function isValidTag(data, userId, tagId) {
      return hasRequiredFields(['id', 'userId', 'projectId', 'name', 'createdAt']) &&
        hasOnlyAllowedFields(['id', 'userId', 'projectId', 'name', 'createdAt']) &&
        data.id is string && data.id == tagId && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.userId is string && data.userId == userId &&
        isNonEmptyString(data.projectId, 128) &&
        isNonEmptyString(data.name, 80) &&
        isNonEmptyString(data.createdAt, 64);
    }

    function isValidTask(data, userId, taskId) {
      return hasRequiredFields(['id', 'userId', 'projectId', 'name', 'completedWorkHours', 'status', 'createdAt']) &&
        hasOnlyAllowedFields([
          'id',
          'userId',
          'projectId',
          'parentTaskId',
          'depth',
          'sortOrder',
          'name',
          'description',
          'tagIds',
          'dueDate',
          'completedWorkHours',
          'status',
          'createdAt',
          'targetHours',
          'externalProvider',
          'externalWorkItemId',
          'externalWorkItemTitle',
          'externalWorkItemType',
          'externalWorkItemUrl',
          'externalOrgUrl',
          'externalProject',
          'externalSyncedAt',
          'externalSupportsCompletedWork'
        ]) &&
        data.id is string && data.id == taskId && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.userId is string && data.userId == userId &&
        isNonEmptyString(data.projectId, 128) &&
        isOptionalBoundedString(data, 'parentTaskId', 128) &&
        (!('parentTaskId' in data) || data.parentTaskId == null || data.parentTaskId != taskId) &&
        (!('depth' in data) || data.depth == null || (data.depth is int && data.depth in [0, 1, 2])) &&
        (!('sortOrder' in data) || data.sortOrder == null || (data.sortOrder is number && data.sortOrder >= -1000000000 && data.sortOrder <= 1000000000)) &&
        isNonEmptyString(data.name, 200) &&
        isOptionalBoundedString(data, 'description', 4000) &&
        (!('tagIds' in data) || data.tagIds == null || isValidStringIdList25(data.tagIds, 128)) &&
        (!('dueDate' in data) || data.dueDate == null || isValidDateKey(data.dueDate)) &&
        data.completedWorkHours is number && data.completedWorkHours >= 0 && data.completedWorkHours <= 100000 &&
        data.status in ['todo', 'in_progress', 'done'] &&
        isNonEmptyString(data.createdAt, 64) &&
        (!('targetHours' in data) || data.targetHours == null || (data.targetHours is number && data.targetHours >= 0 && data.targetHours <= 100000)) &&
        (!('externalProvider' in data) || data.externalProvider == null || data.externalProvider == 'azure_devops') &&
        isOptionalBoundedString(data, 'externalWorkItemId', 128) &&
        isOptionalBoundedString(data, 'externalWorkItemTitle', 300) &&
        isOptionalBoundedString(data, 'externalWorkItemType', 80) &&
        (!('externalWorkItemUrl' in data) || data.externalWorkItemUrl == null || (data.externalWorkItemUrl is string && data.externalWorkItemUrl.size() <= 512 && data.externalWorkItemUrl.matches('^https://.+'))) &&
        isOptionalBoundedString(data, 'externalOrgUrl', 200) &&
        isOptionalBoundedString(data, 'externalProject', 128) &&
        isOptionalBoundedString(data, 'externalSyncedAt', 64) &&
        (!('externalSupportsCompletedWork' in data) || data.externalSupportsCompletedWork == null || data.externalSupportsCompletedWork is bool);
    }

    function isValidTimeLogAdoSync(sync) {
      return sync is map &&
        sync.keys().hasAll(['workItemId', 'orgUrl', 'project', 'syncedSeconds', 'syncedAt']) &&
        sync.keys().hasOnly(['workItemId', 'orgUrl', 'project', 'syncedSeconds', 'syncedAt']) &&
        sync.workItemId is int &&
        sync.workItemId >= 1 &&
        isNonEmptyString(sync.orgUrl, 200) &&
        isNonEmptyString(sync.project, 128) &&
        sync.syncedSeconds is number &&
        sync.syncedSeconds >= 0 &&
        sync.syncedSeconds <= 31536000 &&
        isNonEmptyString(sync.syncedAt, 64);
    }

    function isValidTimeLog(data, userId, logId) {
      return hasRequiredFields([
          'id',
          'userId',
          'description',
          'normalizedDescription',
          'projectId',
          'projectNameSnapshot',
          'projectColorSnapshot',
          'tagIds',
          'isBillable',
          'startTime',
          'endTime',
          'durationSeconds',
          'timeZone',
          'dateKey'
        ]) &&
        hasOnlyAllowedFields([
          'id',
          'userId',
          'description',
          'normalizedDescription',
          'projectId',
          'projectNameSnapshot',
          'projectColorSnapshot',
          'taskId',
          'taskNameSnapshot',
          'tagIds',
          'tagNamesSnapshot',
          'isBillable',
          'startTime',
          'endTime',
          'durationSeconds',
          'timeZone',
          'dateKey',
          'adoSync'
        ]) &&
        data.id is string && data.id == logId && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.userId is string && data.userId == userId &&
        isBoundedString(data.description, 500) &&
        isBoundedString(data.normalizedDescription, 500) &&
        isNonEmptyString(data.projectId, 128) &&
        isNonEmptyString(data.projectNameSnapshot, 120) &&
        isNonEmptyString(data.projectColorSnapshot, 32) &&
        isOptionalBoundedString(data, 'taskId', 128) &&
        isOptionalBoundedString(data, 'taskNameSnapshot', 200) &&
        isValidList(data.tagIds, 25) &&
        (!('tagNamesSnapshot' in data) || data.tagNamesSnapshot == null || isValidList(data.tagNamesSnapshot, 25)) &&
        data.isBillable is bool &&
        isNonEmptyString(data.startTime, 64) &&
        isNonEmptyString(data.endTime, 64) &&
        data.durationSeconds is number && data.durationSeconds >= 0 && data.durationSeconds <= 31536000 &&
        isNonEmptyString(data.timeZone, 100) &&
        isValidDateKey(data.dateKey) &&
        (!('adoSync' in data) || data.adoSync == null || isValidTimeLogAdoSync(data.adoSync));
    }

    function isValidEncryptedAdoSecret(data) {
      return hasRequiredFields(['v', 'authType', 'salt', 'iv', 'tag', 'ciphertext', 'updatedAt']) &&
        hasOnlyAllowedFields(['v', 'authType', 'salt', 'iv', 'tag', 'ciphertext', 'updatedAt']) &&
        data.v is int &&
        data.v == 1 &&
        data.authType in ['pat', 'entra_oauth'] &&
        isNonEmptyString(data.salt, 128) &&
        data.salt.matches('^[A-Za-z0-9+/]+=*$') &&
        isNonEmptyString(data.iv, 64) &&
        data.iv.matches('^[A-Za-z0-9+/]+=*$') &&
        isNonEmptyString(data.tag, 64) &&
        data.tag.matches('^[A-Za-z0-9+/]+=*$') &&
        isNonEmptyString(data.ciphertext, 16384) &&
        data.ciphertext.matches('^[A-Za-z0-9+/]+=*$') &&
        isNonEmptyString(data.updatedAt, 64);
    }

    // ===============================================================
    // Tenant-Isolated User Tree: users/{userId}
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) &&
        isValidUserProfile(request.resource.data) &&
        isValidUserProfileUsernameOwnership(userId);
      allow update: if isOwner(userId) &&
        isValidUserProfile(request.resource.data) &&
        isValidUserProfileUsernameOwnership(userId);
      allow delete: if isOwner(userId);

      match /projects/{projectId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidProject(request.resource.data, userId, projectId);
        allow update: if isOwner(userId) &&
          isDocOwner() &&
          isValidProject(request.resource.data, userId, projectId) &&
          areImmutableFieldsUnchanged(['id', 'userId', 'createdAt']);
        allow delete: if isOwner(userId) && isDocOwner();
      }

      match /tags/{tagId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidTag(request.resource.data, userId, tagId);
        allow update: if isOwner(userId) &&
          isDocOwner() &&
          isValidTag(request.resource.data, userId, tagId) &&
          areImmutableFieldsUnchanged(['id', 'userId', 'projectId', 'createdAt']);
        allow delete: if isOwner(userId) && isDocOwner();
      }

      match /tasks/{taskId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidTask(request.resource.data, userId, taskId);
        allow update: if isOwner(userId) &&
          isDocOwner() &&
          isValidTask(request.resource.data, userId, taskId) &&
          areImmutableFieldsUnchanged(['id', 'userId', 'createdAt']);
        allow delete: if isOwner(userId) && isDocOwner();
      }

      match /timeLogs/{logId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidTimeLog(request.resource.data, userId, logId);
        allow update: if isOwner(userId) &&
          isDocOwner() &&
          isValidTimeLog(request.resource.data, userId, logId) &&
          areImmutableFieldsUnchanged(['id', 'userId']);
        allow delete: if isOwner(userId) && isDocOwner();
      }

      // Owner-only server-encrypted integration secret envelope (users/{userId}/secrets/azureDevOps)
      match /secrets/{secretId} {
        allow get: if isOwner(userId) && secretId == 'azureDevOps';
        allow list: if false;
        allow create, update: if isOwner(userId) &&
          secretId == 'azureDevOps' &&
          isValidEncryptedAdoSecret(request.resource.data);
        allow delete: if isOwner(userId) && secretId == 'azureDevOps';
      }
    }

    // ===============================================================
    // Global Unique Username Index: usernames/{username}
    // ===============================================================

    match /usernames/{username} {
      allow get: if isAuthenticated();
      allow list: if false;
      allow create: if isAuthenticated() &&
        isValidUsernameHandle(username) &&
        hasRequiredFields(['uid', 'createdAt']) &&
        hasOnlyAllowedFields(['uid', 'createdAt']) &&
        request.resource.data.uid == request.auth.uid &&
        isNonEmptyString(request.resource.data.createdAt, 64) &&
        !exists(/databases/$(database)/documents/usernames/$(username));
      allow update: if false;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
