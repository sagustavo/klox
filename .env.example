# Gemini AI (Phase 4 — NUXT_GEMINI_API_KEY or GEMINI_API_KEY)
NUXT_GEMINI_API_KEY=
NUXT_GEMINI_MODEL=gemini-3.8-flash

# Azure DevOps Sync (AB#31 / FR-V1 — 32+ char server secret for AES-256-GCM PAT vault)
NUXT_ADO_ENCRYPTION_KEY=

# Firebase Client SDK (Phase 2 — leave blank to run in local Demo mode)
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=
